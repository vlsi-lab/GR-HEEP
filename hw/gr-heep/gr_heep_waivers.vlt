// File: gr-heep-waivers.sv
// Author: Michele Caon, Luigi Giuffrida
// Date: 14/06/2023
// Description: Waivers for gr-heep top-level

`verilator_config

// lint_off -rule UNUSED -file "*gr_heep.sv" -match "Bits of signal are not used: 'exit_value'[31:1]"
// lint_off -rule UNUSED -file "*gr_heep.sv" -match "Bits of signal are not used: 'memory_subsystem_banks_powergate_switch'[0]"
// lint_off -rule UNUSED -file "*gr_heep.sv" -match "Signal is not used: 'mem_sw_fb_sync'"
// lint_off -rule UNUSED -file "*gr_heep.sv" -match "Signal is not used: '*_powergate_*'"
// lint_off -rule UNUSED -file "*gr_heep.sv" -match "Signal is not used: '*_retentive_*'"
// lint_off -rule UNUSED -file "*gr_heep.sv" -match "Signal is not used: '*ext*'"
// lint_off -rule UNUSED -file "*gr_heep.sv" -match "Signal is not*used: '*_req'"
// lint_off -rule UNUSED -file "*gr_heep.sv" -match "Signal is not*used: '*_rsp'"
// lint_off -rule UNUSED -file "*gr_heep.sv" -match "Signal is not*used: '*_resp'"
// lint_off -rule UNUSED -file "*gr_heep.sv" -match "Bits of signal are not used: 'external_subsystem_powergate_switch_n'[1]"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: 'heep_core_*_req'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: 'heep_debug_*_req'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: 'heep_dma_*_req'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: 'heep_slave_req"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: 'hw_fifo_req"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: 'dma_done'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: 'heep_slave_rsp'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not*used: 'gr_heep_master_req'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not*used: 'gr_heep_master_resp'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: 'heep_peripheral_req'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: 'ext_ao_peripheral_resp'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: '*powergate_iso_n'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: '*set_retentive_n'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: 'external_subsystem_rst_n'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: '*clkgate_en_n'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: 'ext_debug_req'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep.sv" -match "Signal is not used: 'ext_debug_reset_n'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep_bus.sv" -match "Signal is not driven, nor used: 'demux_xbar_req'"
lint_off -rule UNUSEDSIGNAL -file "*gr_heep_bus.sv" -match "Signal is not driven, nor used: 'demux_xbar_resp'"
lint_off -rule UNUSED -file "*gr_heep.sv" -match "Signal is not*used: '*in_x'"
lint_off -rule UNUSED -file "*gr_heep.sv" -match "Signal is not used: '*out_x'"
lint_off -rule UNUSED -file "*gr_heep.sv" -match "Signal is not used: '*oe_x'"

// lint_off -rule UNDRIVEN -file "*gr_heep.sv" -match "Signal is not driven: '*_powergate_*'"
// lint_off -rule UNDRIVEN -file "*gr_heep.sv" -match "Signal is not driven: '*out_x'"
// lint_off -rule UNDRIVEN -file "*gr_heep.sv" -match "Signal is not driven: '*_req'"
// lint_off -rule UNDRIVEN -file "*gr_heep.sv" -match "Signal is not driven: '*_rsp'"
// lint_off -rule UNDRIVEN -file "*gr_heep.sv" -match "Signal is not driven: '*_resp'"
// lint_off -rule UNDRIVEN -file "*gr_heep.sv" -match "Bits of signal are not driven: 'external_subsystem_powergate_switch_ack_n'[1]"
lint_off -rule UNDRIVEN -file "*gr_heep_bus.sv" -match "Signal is not driven: 'ext_master_resp_o'"
lint_off -rule UNDRIVEN -file "*gr_heep_bus.sv" -match "Signal is not driven: 'heep_slave_req_o'"

lint_off -rule SYNCASYNCNET -file "*gr_heep.sv" -match "*spi_slave_cs*"

lint_off -rule COMBDLY -file "*clock_gate.sv" -match "*"
lint_off -rule NOLATCH -file "*clock_gate.sv" -match "*"

lint_off -rule ASCRANGE -file "*gr_heep_bus.sv" -match "Ascending bit range vector: left < right of bit range: [-1:0]"


// Only driven when the W25Q128JW controller cache is enabled, which GR-HEEP does not use
lint_off -rule UNUSEDSIGNAL -file "*w25q128jw_controller.sv" -match "Signal is not used: 'cache_lookup_addr'"
lint_off -rule UNUSEDSIGNAL -file "*w25q128jw_controller.sv" -match "Signal is not used: 'memio_be'"
